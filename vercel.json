{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install && npm install --prefix site",
  "buildCommand": "npm run site:build",
  "outputDirectory": "site/out",
  "headers": [
    {
      "source": "/opengraph-image",
      "headers": [
        { "key": "Content-Type", "value": "image/png" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(robots.txt|llms.txt|llms-full.txt|sitemap.xml)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }
      ]
    },
    {
      "source": "/mcp-apps/sandbox.html",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; frame-src 'self'; frame-ancestors https://m3e.language-lit.com" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    },
    {
      "source": "/mcp-apps/forecast.html",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; frame-ancestors https://material3-expressive.vercel.app https://m3e.language-lit.com" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
