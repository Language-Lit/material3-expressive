{
  "name": "m3e-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Documentation and showcase site for @language-lit/material3-expressive",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test:ag-ui": "node scripts/audit-ag-ui.mjs",
    "predev": "node ../scripts/link-self.mjs",
